digraph incrementer_2 {
	rankdir="LR";
	n_0 [label="incrementer_2", shape="plaintext"];
	n_1 [id="4", shape=circle, label="4"];
	n_2 [id="3", shape=circle, label="3"];
	n_3 [id="2", shape=circle, label="2"];
	n_4 [id="5", shape=circle, label="5"];
	n_5 [id="1", shape=circle, label="1"];
	n_0 -> n_5 [arrowhead=none];
	n_6 [id="7", shape=doublecircle, label="7"];
	n_7 [id="6", shape=circle, label="6"];

	n_3 -> n_2 [id="[$e|1]", label="0#receive answer"];
	n_5 -> n_3 [id="[$e|0]", label="MePid ! {request,pid_self}"];
	n_2 -> n_1 [id="[$e|2]", label="XPid ! {read,pid_self}"];
	n_7 -> n_6 [id="[$e|5]", label="MePid ! {release}"];
	n_1 -> n_4 [id="[$e|3]", label="0#receive X"];
	n_4 -> n_7 [id="[$e|4]", label="XPid ! {write,any}"];
}
